{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "truong-group/surgeon-list",
	"title": "Surgeon List",
	"category": "truong-group",
	"icon": "groups",
	"description": "Lists Surgeon posts as a list or a 2/3/4-column card grid, with the option to exclude specific surgeons.",
	"textdomain": "truong-group",
	"supports": {
		"html": false
	},
	"attributes": {
		"layout": {
			"type": "string",
			"default": "list"
		},
		"columns": {
			"type": "number",
			"default": 3
		},
		"excludedIds": {
			"type": "array",
			"default": [],
			"items": {
				"type": "number"
			}
		}
	}
}
